<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:int="clr-namespace:Invoices.Integration"
        x:Class="Invoices.Interface.PaymentImportDialog"
        Title="Import Payment from Processor"
        WindowStartupLocation="CenterOwner"
        Width="800"
        Height="400"
        MinHeight="200">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0">Select recent payment to import:</Label>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBox Name="txtSeconds" Width="40" Text="900" VerticalAlignment="Center" GotFocus="txtSeconds_GotFocus" LostFocus="txtSeconds_LostFocus" />
                <Label VerticalAlignment="Center" Margin="4 0 10 0">seconds</Label>
                <Button Name="cmdRefresh" Padding="7 4" VerticalAlignment="Center" Click="cmdRefresh_Click">Refresh</Button>
            </StackPanel>
        </Grid>

        <ListBox Grid.Row="1" Name="lbRecentPayments" GotFocus="lbRecentPayments_GotFocus" LostFocus="lbRecentPayments_LostFocus">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Label MouseDoubleClick="lbRecentPayments_ItemDoubleClick">
                        <TextBlock>
                            <Run Text="{Binding SourceType}" />
                            <Run Text=": " />
                            <Run Text="{Binding Total, StringFormat=c}" />
                            <Run Text=" at " />
                            <Run Text="{Binding TransactionDateTime, Mode=OneWay}" />
                        </TextBlock>
                    </Label>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Label Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4" Name="lblRefreshing">Refreshing...</Label>

        <UniformGrid Grid.Row="2" Rows="1" HorizontalAlignment="Center">
            <Button Name="cmdImport" Padding="7 4" Margin="4" Click="cmdImport_Click">_Import</Button>
            <Button Name="cmdCancel" Padding="7 4" Margin="4" Click="cmdCancel_Click">Ca_ncel</Button>
        </UniformGrid>
    </Grid>
</Window>