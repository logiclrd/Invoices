<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Invoices.Core;assembly=Invoices.Core"
             xmlns:interface="clr-namespace:Invoices.Interface"
             xmlns:converter="clr-namespace:Invoices.Interface.Converters"
             x:Class="Invoices.Interface.Controls.InvoiceEditor"
             PreviewKeyDown="InvoiceEditor_PreviewKeyDown">
    <UserControl.Resources>
        <interface:TaxDefinitionList x:Key="AllTaxes" />
        <interface:PaymentTypesList x:Key="AllPaymentTypes" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <WrapPanel>
                <WrapPanel.Resources>
                    <Style TargetType="StackPanel">
                        <Setter Property="Margin" Value="12" />
                    </Style>
                    <Style TargetType="Grid">
                        <Setter Property="Margin" Value="12" />
                    </Style>
                </WrapPanel.Resources>

                <StackPanel>
                    <Label>Invoice #</Label>
                    <TextBox Name="txtInvoiceNumber" TextChanged="txtInvoiceNumber_TextChanged" />
                </StackPanel>

                <StackPanel>
                    <Label>Date</Label>
                    <DatePicker Name="dtpInvoiceDate" SelectedDateChanged="dtpInvoiceDate_SelectedDateChanged" />
                </StackPanel>

                <Grid VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Label Grid.ColumnSpan="2">Customer</Label>
                    <TextBox Grid.Row="1" Grid.Column="0" Name="txtCustomer" AcceptsReturn="true" IsReadOnly="true" />
                    <Button Grid.Row="1" Grid.Column="1" Width="30">..</Button>
                </Grid>

                <StackPanel>
                    <Label>State</Label>
                    <ComboBox Name="cboState" SelectionChanged="cboState_SelectionChanged">
                        <x:Static Member="core:InvoiceState.Ready" />
                        <x:Static Member="core:InvoiceState.Waiting" />
                        <x:Static Member="core:InvoiceState.Finished" />
                    </ComboBox>
                    <TextBox Name="txtStateDescription" Width="400" TextChanged="txtStateDescription_TextChanged" />
                </StackPanel>
            </WrapPanel>

            <StackPanel Margin="12">
                <Label>Items</Label>
                <DataGrid Name="dgItems" CellEditEnding="dgItems_CellEditEnding" CanUserAddRows="true" CanUserDeleteRows="true" AutoGenerateColumns="false">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="dgtcDescription" Width="500" Header="Description" Binding="{Binding Description}" />
                        <DataGridTextColumn x:Name="dgtcQuantity" Header="Quantity" Binding="{Binding Quantity}" />
                        <DataGridTemplateColumn x:Name="dgtcAtSign" Header="">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Label Content="@" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="dgtcUnitPrice" Binding="{Binding UnitPrice, StringFormat=C2}" />
                        <DataGridTextColumn x:Name="dgtcSubtotal" IsReadOnly="true" Binding="{Binding LineTotal, StringFormat=C2}" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <StackPanel Margin="12 100 12 12">
                <Label>Taxes</Label>
                <DataGrid Name="dgTaxes" CellEditEnding="dgTaxes_CellEditEnding" AutoGenerateColumns="false">
                    <DataGrid.Columns>
                        <DataGridComboBoxColumn x:Name="dgcbcTaxName" Header="Name" SelectedValueBinding="{Binding TaxID}" SelectedItemBinding="{Binding TaxName}" ItemsSource="{StaticResource AllTaxes}" DisplayMemberPath="TaxName" SelectedValuePath="TaxID" />
                        <DataGridTextColumn x:Name="dgtcTaxRate" Header="Rate" IsReadOnly="true" Binding="{Binding TaxRate, Converter={converter:Percentage}}" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <StackPanel Margin="12 100 12 12">
                <Label>Payments</Label>
                <DataGrid Name="dgPayments" CellEditEnding="dgPayments_CellEditEnding" AutoGenerateColumns="false">
                    <DataGrid.Columns>
                        <DataGridComboBoxColumn x:Name="dgcbcPaymentType" Header="Type" SelectedValueBinding="{Binding PaymentType, Converter={interface:PaymentTypesList+Converter}}" ItemsSource="{StaticResource AllPaymentTypes}" />
                        <DataGridTextColumn x:Name="dgtcPaymentTypeCustom" Header="Custom Payment Type" Binding="{Binding PaymentTypeCustom}" />
                        <DataGridTemplateColumn x:Name="dgtcReceivedDateTime" Header="Received">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ReceivedDateTime}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <DatePicker SelectedDate="{Binding ReceivedDateTime}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="dgtcAmount" Header="Amount" Binding="{Binding Amount, StringFormat=C2}" />
                        <DataGridTextColumn x:Name="dgtcReferenceNumber" Header="Reference Number" Binding="{Binding ReferenceNumber}" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <StackPanel Margin="12">
                <Label>Notes</Label>
                <TextBox Name="txtNotes" AcceptsReturn="true" Height="100" TextChanged="txtNotes_TextChanged" />
            </StackPanel>

            <StackPanel Margin="12">
                <Label>Internal Notes</Label>
                <TextBox Name="txtInternalNotes" AcceptsReturn="true" Height="100" TextChanged="txtInternalNotes_TextChanged" />
            </StackPanel>

            <!-- TODO: relations -->
        </StackPanel>
    </ScrollViewer>
</UserControl>
