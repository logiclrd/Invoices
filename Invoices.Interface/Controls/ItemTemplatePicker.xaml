<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviours="clr-namespace:Invoices.Interface.Behaviours"
             xmlns:controls="clr-namespace:Invoices.Interface.Controls"
             xmlns:converters="clr-namespace:Invoices.Interface.Converters"
             xmlns:core="clr-namespace:Invoices.Core;assembly=Invoices.Core"
             x:Class="Invoices.Interface.Controls.ItemTemplatePicker">
    <ScrollViewer>
        <ItemsControl ItemsSource="{Binding ItemTemplates}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type core:ItemTemplate}">
                    <Button Name="cmdTemplate" Click="cmdTemplate_Click" Width="130" Height="60" Margin="6">
                        <controls:ItemTemplatePresenter Width="130" Height="60" />
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>