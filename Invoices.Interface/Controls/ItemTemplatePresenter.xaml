<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Invoices.Interface.Converters"
             x:Class="Invoices.Interface.Controls.ItemTemplatePresenter">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>

        <Label Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0" Content="{Binding UnitPrice}" ContentStringFormat="C2" />

        <Label Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Padding="2">
            <TextBlock TextWrapping="WrapWithOverflow" Text="{Binding Description}" TextAlignment="Center" />
        </Label>
    </Grid>
</UserControl>