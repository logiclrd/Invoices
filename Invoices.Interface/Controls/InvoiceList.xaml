<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converter="clr-namespace:Invoices.Interface.Converters"
             x:Class="Invoices.Interface.Controls.InvoiceList">
    <DataGrid Name="dgList" ItemsSource="{Binding Invoices}" AutoGenerateColumns="false" LoadingRow="dgList_LoadingRow">
        <DataGrid.Columns>
            <DataGridTextColumn x:Name="dgtcInvoiceNumber" Header="#" Binding="{Binding InvoiceNumber}" />
            <DataGridTextColumn x:Name="dgtcInvoicee" Header="Invoicee" Binding="{Binding InvoiceeCustomer, Converter={converter:CustomerSummary}}" />
            <DataGridTextColumn x:Name="dgtcInvoiceDate" Header="Date" Binding="{Binding InvoiceDate, StringFormat=yyyy-MM-dd}" />
            <DataGridTextColumn x:Name="dgtcState" Header="State" Binding="{Binding State}" />
            <DataGridTextColumn x:Name="dgtcTotal" Header="Total (incl. Tax)" Binding="{Binding ., Converter={converter:InvoiceTotal}, StringFormat=C2}">
                <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Right" />
                    </Style>
                </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn x:Name="dgtcOutstanding" Header="Outstanding" Binding="{Binding ., Converter={converter:InvoiceOutstanding}, StringFormat=C2}">
                <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Right" />
                    </Style>
                </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
