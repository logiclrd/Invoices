<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Invoices.Interface.PrintPreview">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#666">
            <Grid.Resources>
                <Style TargetType="Button">
                    <Setter Property="Margin" Value="12" />
                    <Setter Property="Width" Value="60" />
                    <Setter Property="Height" Value="23" />
                </Style>
            </Grid.Resources>
            <Button Name="cmdPrint" Click="cmdPrint_Click" HorizontalAlignment="Left">Print...</Button>
            <Button Name="cmdClose" Click="cmdClose_Click" HorizontalAlignment="Right" IsCancel="true">Close</Button>
        </Grid>

        <ScrollViewer Name="svPresentation" Grid.Row="1" Background="Black" HorizontalScrollBarVisibility="Auto">
            <Grid Background="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Name="imgPreview" Stretch="None" Margin="30" Cursor="ScrollAll" MouseDown="imgPreview_MouseDown" MouseMove="imgPreview_MouseMove" MouseUp="imgPreview_MouseUp" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>